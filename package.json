{
  "name": "uniview",
  "version": "1.0.0",
  "description": "Open-source React viewer for PDF, DOCX, DWG, DXF, XLSX, images and more",
  "main": "dist/uniview.cjs.js",
  "module": "dist/uniview.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/uniview.esm.js",
      "require": "./dist/uniview.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "keywords": [
    "pdf viewer",
    "dwg viewer",
    "dxf viewer",
    "docx viewer",
    "cad viewer",
    "file viewer",
    "xlsx viewer",
    "document viewer",
    "webgl",
    "threejs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/manu14357/uniview"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:workers": "WORKER_INDEX=0 vite build --config vite.workers.config.ts && WORKER_INDEX=1 vite build --config vite.workers.config.ts && WORKER_INDEX=2 vite build --config vite.workers.config.ts && cp src/vendor/uniview-dwg/uniview-dwg-wasm/libredwg-web.wasm demo/public/workers/",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:demo": "npm run build:workers && vite build --config vite.demo.config.ts",
    "build:docs": "npm run build:demo",
    "prepublishOnly": "npm run build && npm run build:types"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@fxts/core": "^1.0.1",
    "@velipso/polybool": "^2.0.11",
    "buffer": "^6.0.3",
    "dxf-viewer": "^1.0.20",
    "events": "^3.3.0",
    "iconv-lite": "^0.7.0",
    "idb": "^8.0.3",
    "lodash-es": "^4.17.21",
    "loglevel": "^1.9.1",
    "mammoth": "^1.8.0",
    "mitt": "^3.0.1",
    "opentype.js": "^1.3.4",
    "pdfjs-dist": "^4.9.155",
    "rbush": "^4.0.1",
    "stream-browserify": "^3.0.0",
    "three": "^0.172.0",
    "uid": "^2.0.2",
    "util": "^0.12.5",
    "verb-nurbs-web": "^2.1.3",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/react": "^14.3.1",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.172.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tailwindcss": "^3.4.17",
    "terser": "^5.46.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.0"
  }
}
