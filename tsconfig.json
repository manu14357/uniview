{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@uniview/viewer": ["src/vendor/uniview-dwg/uniview-viewer/index.ts"],
      "@uniview/three-renderer": ["src/vendor/uniview-dwg/uniview-three-renderer/index.ts"],
      "@uniview/svg-renderer": ["src/vendor/uniview-dwg/uniview-svg-renderer/index.ts"],
      "@uniview/data-model": ["src/vendor/uniview-dwg/uniview-data-model/index.ts"],
      "@uniview/dwg-converter": ["src/vendor/uniview-dwg/uniview-dwg-converter/index.ts"],
      "@uniview/dwg-wasm": ["src/vendor/uniview-dwg/uniview-dwg-wasm/index.d.ts"],
      "@uniview/common": ["src/vendor/uniview-dwg/uniview-common/index.ts"],
      "@uniview/geometry": ["src/vendor/uniview-dwg/uniview-geometry/index.ts"],
      "@uniview/graphics": ["src/vendor/uniview-dwg/uniview-graphics/index.ts"],
      "@uniview/mtext-renderer": ["src/vendor/uniview-dwg/uniview-mtext-renderer/index.ts"],
      "@uniview/viewcube": ["src/vendor/uniview-dwg/uniview-viewcube/index.ts"],
      "@uniview/mtext-parser": ["src/vendor/uniview-dwg/uniview-mtext-parser/index.ts"],
      "@uniview/shx-parser": ["src/vendor/uniview-dwg/uniview-shx-parser/index.ts"],
      "@uniview/dxf-parser": ["src/vendor/uniview-dwg/uniview-dxf-parser/index.ts"]
    },
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "demo", "tests", "src/vendor/**/*.test.ts"]
}
